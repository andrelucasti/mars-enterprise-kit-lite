    {
      "id": "stat-connections",
      "title": "Conexões Activas",
      "description": "Total de conexões activas em todas as bases de dados",
      "panelTypes": "value",
      "fillSpans": false,
      "isStacked": false,
      "mergeAllActiveQueries": false,
      "nullZeroValues": "zero",
      "opacity": "1",
      "softMax": 0,
      "softMin": 0,
      "thresholds": [
        { "index": 0, "type": "absolute", "value": 80, "color": "#F5A623" },
        { "index": 1, "type": "absolute", "value": 95, "color": "#FF0B0B" }
      ],
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "short",
      "query": {
        "queryType": "promql",
        "builder": { "queryData": [], "queryFormulas": [] },
        "clickhouse_sql": [{ "disabled": false, "legend": "", "name": "A", "query": "" }],
        "id": "stat-connections-q",
        "promql": [
          {
            "disabled": false,
            "legend": "Conexões",
            "name": "A",
            "query": "sum(pg_stat_database_numbackends{datname!~\"template.*|postgres\"})"
          }
        ]
      }
    },

    {
      "id": "stat-tps",
      "title": "Transacções / seg",
      "description": "Taxa combinada de commits e rollbacks por segundo",
      "panelTypes": "value",
      "fillSpans": false,
      "isStacked": false,
      "mergeAllActiveQueries": false,
      "nullZeroValues": "zero",
      "opacity": "1",
      "softMax": 0,
      "softMin": 0,
      "thresholds": [],
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "short",
      "query": {
        "queryType": "promql",
        "builder": { "queryData": [], "queryFormulas": [] },
        "clickhouse_sql": [{ "disabled": false, "legend": "", "name": "A", "query": "" }],
        "id": "stat-tps-q",
        "promql": [
          {
            "disabled": false,
            "legend": "TPS",
            "name": "A",
            "query": "sum(rate(pg_stat_database_xact_commit{datname!~\"template.*|postgres\"}[5m]) + rate(pg_stat_database_xact_rollback{datname!~\"template.*|postgres\"}[5m]))"
          }
        ]
      }
    },

    {
      "id": "stat-cache-hit",
      "title": "Cache Hit Ratio",
      "description": "Percentagem de blocos lidos da cache vs disco. Ideal > 99%",
      "panelTypes": "value",
      "fillSpans": false,
      "isStacked": false,
      "mergeAllActiveQueries": false,
      "nullZeroValues": "zero",
      "opacity": "1",
      "softMax": 0,
      "softMin": 0,
      "thresholds": [
        { "index": 0, "type": "percentage", "value": 95, "color": "#FF0B0B" }
      ],
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "percentunit",
      "query": {
        "queryType": "promql",
        "builder": { "queryData": [], "queryFormulas": [] },
        "clickhouse_sql": [{ "disabled": false, "legend": "", "name": "A", "query": "" }],
        "id": "stat-cache-hit-q",
        "promql": [
          {
            "disabled": false,
            "legend": "Cache Hit",
            "name": "A",
            "query": "sum(pg_stat_database_blks_hit{datname!~\"template.*|postgres\"}) / (sum(pg_stat_database_blks_hit{datname!~\"template.*|postgres\"}) + sum(pg_stat_database_blks_read{datname!~\"template.*|postgres\"}))"
          }
        ]
      }
    },

