    {
      "id": "stat-cpu",
      "title": "CPU Usage",
      "description": "Average CPU utilisation across all cores",
      "panelTypes": "value",
      "fillSpans": false,
      "isStacked": false,
      "mergeAllActiveQueries": false,
      "nullZeroValues": "zero",
      "opacity": "1",
      "softMax": 0,
      "softMin": 0,
      "thresholds": [
        { "index": 0, "type": "percentage", "value": 80, "color": "#FF0B0B" }
      ],
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "percentunit",
      "query": {
        "queryType": "promql",
        "builder": { "queryData": [], "queryFormulas": [] },
        "clickhouse_sql": [{ "disabled": false, "legend": "", "name": "A", "query": "" }],
        "id": "stat-cpu-q",
        "promql": [
          {
            "disabled": false,
            "legend": "CPU Usage",
            "name": "A",
            "query": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))"
          }
        ]
      }
    },
    {
      "id": "stat-memory",
      "title": "Memory Usage",
      "description": "Used memory / Total memory",
      "panelTypes": "value",
      "fillSpans": false,
      "isStacked": false,
      "mergeAllActiveQueries": false,
      "nullZeroValues": "zero",
      "opacity": "1",
      "softMax": 0,
      "softMin": 0,
      "thresholds": [
        { "index": 0, "type": "percentage", "value": 85, "color": "#FF0B0B" }
      ],
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "percentunit",
      "query": {
        "queryType": "promql",
        "builder": { "queryData": [], "queryFormulas": [] },
        "clickhouse_sql": [{ "disabled": false, "legend": "", "name": "A", "query": "" }],
        "id": "stat-memory-q",
        "promql": [
          {
            "disabled": false,
            "legend": "Memory Usage",
            "name": "A",
            "query": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)"
          }
        ]
      }
    },
    {
      "id": "stat-disk-used",
