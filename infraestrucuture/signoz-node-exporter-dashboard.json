        "id": "stat-disk-q",
        "promql": [
          {
            "disabled": false,
            "legend": "Disk Usage /",
            "name": "A",
            "query": "1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})"
          }
